filters:
  and:
    - note["base"] == link("Base Veredas d20.base")
properties:
  file.name:
    displayName: Name
  Tipo de vantagem:
    displayName: Tipo de vantagem
  Dependências:
    displayName: Dependências
  Conteúdo:
    displayName: Conteúdo
  Created time:
    displayName: Created time
  Requisitos:
    displayName: Requisitos
  Descrição:
    displayName: Descrição
  Situação:
    displayName: Situação
  Última edição:
    displayName: Última edição
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Tipo de vantagem
      - Dependências
      - Conteúdo
      - Created time
      - Requisitos
      - Descrição
      - Situação
      - Última edição
